// use prisma-8

enum RouteType {
    set // 集合
    group // 分组
    directory // 目录
    page // 页面
    button // 按钮链接
    link // 外链

    @@type("pg/text@1")
}

model SystemRouter{
    id String @id @default(cuid(2))
    name String 
    path String?
    icon String?
    parentId String? @map("parent_id")
    routeType RouteType @map("route_type")
    sortOrder Int @default(0) @map("sort_order")
    isFold Boolean @default(false) @map("is_fold")
    isActive Boolean @default(true) @map("is_active")
    createdAt TimestamptzString @default(now()) @map("created_at")
    modifiedAt temporal.updatedAtString() @map("modified_at")
    removedAt TimestamptzString? @map("removed_at")

    @@unique([path])
    @@index([parentId, sortOrder])
    @@index([isActive, removedAt])
    @@map("system_routers")
}