// use prisma-next

enum RouteType {
  group
  page
  directory
  link
  // button

  @@type("pg/text@1")
}

// 系统路由
model SystemRouter{
  id          String    @id @default(cuid(2))
  name        String
  path        String?   // group 可空；page/directory 内部路径；link 为 URL
  icon        String?   @map("icon")          // Lucide 名，如 "LayoutDashboard"
  parentId    String?   @map("parent_id")
  routeType   RouteType @map("route_type")
  sortOrder   Int       @default(0) @map("sort_order")
  defaultOpen Boolean   @default(false) @map("default_open") // 主要给 directory
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")
  deletedAt   TimestamptzString? @map("deleted_at")
  
  parent   SystemRouter?  @relation("ParentRouter", fields: [parentId], references: [id])
  children SystemRouter[] @relation("ParentRouter")

  @@unique([path]) // PG 允许多个 NULL，多个 group 无 path 没问题
  @@index([parentId, sortOrder])
  @@index([isActive, deletedAt])
  @@map("system_routers")
}

// 内容分类（文章/页面）
model ContentCategory{
  id String @id @default(cuid(2))
  name String 
  slug String
  parentId String? @map("parent_id")
  description String?
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")
  deletedAt TimestamptzString? @map("deleted_at")

  parent ContentCategory? @relation("ParentCategory", fields: [parentId], references: [id])
  children ContentCategory[] @relation("ParentCategory")

  @@unique([slug])
  @@index([parentId, sortOrder])
  @@index([isActive, deletedAt])
  @@map("content_categories")
}

// 内容标签
model ContentTag {
  id String @id @default(cuid(2))
  name String
  slug String
  description String?
  isActive Boolean @default(true) @map("is_active")
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")
  deletedAt TimestamptzString? @map("deleted_at")

  @@unique([slug])
  @@index([isActive, deletedAt])
  @@map("content_tags")
}