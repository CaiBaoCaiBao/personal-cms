// use prisma-next

enum RouteType {
  set
  group
  page
  directory
  link
  button

  @@type("pg/text@1")
}

enum RouteScope {
  public
  admin

  @@type("pg/text@1")
}

enum ArticleStatus {
  draft // 草稿
  published // 已发布
  archived // 已归档
  scheduled // 已安排

  @@type("pg/text@1")
}

// 系统路由
model SystemRouter{
  id          String    @id @default(cuid(2))
  name        String
  path        String?   // set/page/directory/button 内部路径；group 可空；link 为 URL
  icon        String?   @map("icon")          // Lucide 名，如 "LayoutDashboard"
  permissionId String?  @map("permission_id")
  parentId    String?   @map("parent_id")
  routeType   RouteType @map("route_type")
  sortOrder   Int       @default(0) @map("sort_order")
  defaultOpen Boolean   @default(false) @map("default_open") // 主要给 directory
  isActive    Boolean   @default(true) @map("is_active")
  scope       RouteScope @default(admin)
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")
  deletedAt   TimestamptzString? @map("deleted_at")
  
  parent   SystemRouter?  @relation("ParentRouter", fields: [parentId], references: [id])
  children SystemRouter[] @relation("ParentRouter")
  permission SystemPermission? @relation("SystemPermission", fields: [permissionId], references: [id])

  @@unique([path]) // PG 允许多个 NULL，多个 group 无 path 没问题
  @@index([parentId, sortOrder])
  @@index([isActive, deletedAt])
  @@index([scope, isActive, deletedAt])
  @@map("system_routers")
}

// 系统权限
model SystemPermission{
  id String @id @default(cuid(2))
  code String
  description String?
  isActive Boolean @default(true) @map("is_active")
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")
  deletedAt TimestamptzString? @map("deleted_at")

  routers SystemRouter[] @relation("SystemPermission")

  @@unique([code])
  @@index([isActive, deletedAt])
  @@map("system_permissions")
}

// 内容分类（文章/页面）
model ContentCategory{
  id String @id @default(cuid(2))
  name String 
  slug String
  parentId String? @map("parent_id")
  description String?
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")
  deletedAt TimestamptzString? @map("deleted_at")

  parent ContentCategory? @relation("ParentCategory", fields: [parentId], references: [id])
  children ContentCategory[] @relation("ParentCategory")
  articles Article[] @relation("ArticleCategory")

  @@unique([slug])
  @@index([parentId, sortOrder])
  @@index([isActive, deletedAt])
  @@map("content_categories")
}

// 内容标签
model ContentTag {
  id String @id @default(cuid(2))
  name String
  slug String
  description String?
  isActive Boolean @default(true) @map("is_active")
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")
  deletedAt TimestamptzString? @map("deleted_at")

  articles Article[]

  @@unique([slug])
  @@index([isActive, deletedAt])
  @@map("content_tags")
}

// 文章内容
model Article{
  id String @id @default(cuid(2))
  title String
  slug String
  htmlContent String
  jsonContent Json
  coverImg String? @map("cover_img")
  wordCount Int @default(0) @map("word_count")
  readMinutes Int @default(0) @map("read_minutes")
  status ArticleStatus @default(draft)
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")
  publishedAt TimestamptzString? @map("published_at")
  archivedAt TimestamptzString? @map("archived_at")
  scheduledAt TimestamptzString? @map("scheduled_at")
  deletedAt TimestamptzString? @map("deleted_at")
  contentCategoryId String? @map("content_category_id")

  contentCategory ContentCategory? @relation("ArticleCategory", fields: [contentCategoryId], references: [id])
  contentTags ContentTag[]
  relatedFrom ArticleRelation[] @relation("RelatedFrom")
  relatedTo ArticleRelation[] @relation("RelatedTo")

  @@unique([slug])
  @@index([title])
  @@index([status, deletedAt, publishedAt], name: "articles_pub_timeline")
  @@index([contentCategoryId, status, deletedAt, publishedAt], name: "articles_cat_pub_timeline")
  @@map("articles")
}

// 文章-标签
model ArticleTag {
  articleId String @map("article_id")
  tagId     String @map("tag_id")

  article Article    @relation(fields: [articleId], references: [id])
  tag     ContentTag @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

// 手工关联文章（有序）
model ArticleRelation {
  articleId        String @map("article_id")
  relatedArticleId String @map("related_article_id")
  sortOrder        Int    @default(0) @map("sort_order")

  article        Article @relation("RelatedFrom", fields: [articleId], references: [id])
  relatedArticle Article @relation("RelatedTo", fields: [relatedArticleId], references: [id])

  @@id([articleId, relatedArticleId])
  @@index([articleId, sortOrder])
  @@map("article_relations")
}
