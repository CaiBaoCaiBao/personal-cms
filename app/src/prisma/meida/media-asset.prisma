// use prisma-8

// 媒体资产
model MediaAsset {
  id String @id @onCreate(uuid(7))
  title String
  description String?
  kind String
  status String
  createdAt TimestamptzString() @default(now()) @map("created_at")
  updatedAt temporal.UpdatedAt @map("updated_at")

  folderId String?
  folder MediaFolder? @relation(fields: [folderId], references: [id])

  currentFileId String?
  currentFile MediaFile? @relation("AssetCurrentFile",fields: [currentFileId], references: [id])

  files MediaFile[] @relation("MediaAssetFiles")
  
  @@map("media_assets")
}

// - kind / status 是普通字符串，用 Zod 收紧枚举
// status: draft / ready / archived
// - 媒体资产不存 url / storageKey 。取图走 currentFile 或 某个 variant